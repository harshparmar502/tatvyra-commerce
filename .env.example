# Copy to .env.local for local development, and add the same names in
# Vercel > Project > Settings > Environment Variables for production.
# Never commit real values. Only VITE_* variables reach the browser.

# --- Which payment provider the checkout uses -------------------------------
# razorpay = live checkout through /api. Anything else = demo, no money moves.
VITE_PAYMENT_PROVIDER=mock

# --- Shopify (orders and products) ------------------------------------------
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Either a fixed Admin API token...
SHOPIFY_ADMIN_TOKEN=
# ...or a Dev Dashboard app's client credentials (leave the token empty).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Razorpay (payments) ----------------------------------------------------
# Use rzp_test_ keys until you are ready to take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (PIN code check; shipments sync from Shopify) ----------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PIN=
